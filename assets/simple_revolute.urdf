<?xml version="1.0"?>
<robot name="rigpi_simple_revolute">
  <link name="base">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <link name="moving_link">
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry>
        <box size="0.05 0.05 0.5"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.25"/>
      <geometry>
        <box size="0.05 0.05 0.5"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.25"/>
      <inertia ixx="2.104e-2" ixy="0" ixz="0"
               iyy="2.104e-2" iyz="0" izz="4.167e-4"/>
    </inertial>
  </link>

  <joint name="hinge" type="revolute">
    <parent link="base"/>
    <child link="moving_link"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="1000" velocity="10"/>
    <dynamics damping="0" friction="0"/>
  </joint>
</robot>
